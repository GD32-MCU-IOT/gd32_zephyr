config I2C_GD32
	bool "GigaDevice GD32 I2C driver"
	default y
	depends on DT_HAS_GD_GD32_I2C_ENABLED || DT_HAS_GD_GD32_I2C_V2_ENABLED
	select PINCTRL
	select USE_GD32_I2C
	help
	  Enable I2C support on the GD32 SoCs

if I2C_GD32

config I2C_GD32_LEGACY
	def_bool DT_HAS_GD_GD32_I2C_ENABLED
	help
	  Driver for the legacy GD32 I2C IP (gd,gd32-i2c).

config I2C_GD32_V2
	def_bool DT_HAS_GD_GD32_I2C_V2_ENABLED
	help
	  Driver for the GD32 ADD I2C IP with TIMING register (gd,gd32-i2c-v2).

endif # I2C_GD32

config I2C_GD32_DMA
	bool "GD32 I2C DMA support"
	depends on I2C_GD32 && DMA
	help
	  Enable DMA support for GD32 I2C controllers.
	  This can significantly improve performance for large transfers
	  by offloading data movement from the CPU to the DMA controller.

if I2C_GD32_DMA

config I2C_GD32_DMA_THRESHOLD
	int "DMA transfer threshold (bytes)"
	default 8
	help
	  Minimum transfer size (in bytes) to use DMA instead of PIO mode.
	  Transfers smaller than this threshold will use PIO mode.
	  Note: valid values are from 1 to 255 (bytes). Default is 8.


config I2C_GD32_DMA_TIMEOUT
	int "DMA transfer timeout (ms)"
	default 500
	help
	  Timeout in milliseconds for DMA transfers. If a transfer does not
	  complete within this time, the driver falls back to PIO mode.
	  Note: valid values are from 100 to 10000 (milliseconds). Default is 500.


endif # I2C_GD32_DMA
