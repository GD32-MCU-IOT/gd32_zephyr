/dts-v1/;

#include <gd/gd32h77x_78x/gd32h77d.dtsi>
#include "gd32h77di_eval-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/dma/gd32_dma.h>

/ {
	model = "GigaDevice GD32H77DI-EVAL";
	compatible = "gd,gd32h77di-eval";

	chosen {
		zephyr,sram = &sram0;
		zephyr,dtcm = &dtcm;
		zephyr,flash = &flash0;
		zephyr,console = &usart0;
		zephyr,shell-uart = &usart0;
		zephyr,flash-controller = &fmc;
		zephyr,canbus = &can2;
	};

	leds {
		compatible = "gpio-leds";

		led0: led0 {
			gpios = <&gpiog 0 GPIO_ACTIVE_HIGH>;
		};

		led1: led1 {
			gpios = <&gpiog 1 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys";

		wakeup_key: wakeup_key {
			label = "WAKEUP";
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_WAKEUP>;
		};

		tamper_key: tamper_key {
			label = "TAMPER";
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_key: user_key {
			label = "USER";
			gpios = <&gpioa 3 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &user_key;
		watchdog0 = &fwdgt;
		spi-flash0 = &nor_flash;
		eeprom-0 = &eeprom0;
	};

	zephyr,user {
		io-channels = <&adc0 2>;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Last two 64KB CNVM sectors */
		storage_partition: partition@1e0000 {
			label = "storage";
			reg = <0x001e0000 DT_SIZE_K(128)>;
		};
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&gpiog {
	status = "okay";
};

&usart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
};

&usart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart2_default>;
	pinctrl-names = "default";
};

&fwdgt {
	status = "okay";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&timer1 {
	status = "okay";
	prescaler = <0>;

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&pwm1_default>;
		pinctrl-names = "default";
	};
};

&dma0 {
	status = "okay";
};

&dma1 {
	status = "okay";
};

&dmamux {
	status = "okay";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	dmas = <&dmamux 2 45 (GD32_DMA_PERIPH_RX | GD32_DMA_PRIORITY_HIGH)>,
	       <&dmamux 3 46 (GD32_DMA_PERIPH_TX | GD32_DMA_PRIORITY_HIGH)>;
	dma-names = "rx", "tx";

	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <256>;
		pagesize = <8>;
		address-width = <8>;
		timeout = <5>;
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
};

&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
	dmas = <&dmamux 4 97 (GD32_DMA_PERIPH_RX | GD32_DMA_PRIORITY_HIGH)>,
	       <&dmamux 5 98 (GD32_DMA_PERIPH_TX | GD32_DMA_PRIORITY_HIGH)>;
	dma-names = "rx", "tx";

	nor_flash: gd25q16@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		size = <0x1000000>;
		spi-max-frequency = <4000000>;
		jedec-id = [c8 40 15];
		status = "okay";
	};
};

&can2 {
	status = "okay";
	pinctrl-0 = <&can2_default>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	bitrate-data = <1000000>;
	sample-point = <800>;
	sample-point-data = <800>;
};
