/*
 * SPI0 (PA5/PA6/PA7 + PA4 CS) is reserved for the on-board GD25Q16 NOR flash
 * used by the flash test, so the SPI loopback runs on SPI2 with a dedicated set
 * of free GPIOC pins:
 *   SCK  = PC10
 *   MISO = PC11
 *   MOSI = PC12
 * The fixture must short MOSI (PC12) to MISO (PC11) for the loopback transfers.
 */

/ {
	zephyr,user {
		/* PC12 (MOSI) is shorted to PC11 (MISO) for the deinit test. */
		mosi-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
	};
};

/* The NOR flash lives on SPI0; keep it out of the loopback build. */
&nor_flash {
	status = "disabled";
};

&pinctrl {
	spi2_default: spi2_default {
		group1 {
			pinmux = <SPI2_SCK_PC10>, <SPI2_MOSI_PC12>,
				 <SPI2_MISO_PC11>;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <16000000>;
	};
};
