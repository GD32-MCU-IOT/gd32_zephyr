/ {
	zephyr,user {
		/* PC12 (MOSI) is shorted to PC11 (MISO) for the deinit test. */
		mosi-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;
	};
};

&spi2 {
	status = "okay";

	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <16000000>;
	};
};
